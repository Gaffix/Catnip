{
  "schemaVersion": 1,
  "id": "catnip",
  "version": "${version}",
  "name": "Catnip",
  "description": "A Fabric mod for Minecraft 26.2.",
  "authors": [
    "Gaffix"
  ],
  "license": "CC0-1.0",
  "icon": "assets/catnip/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.gaffix.catnip.Catnip"
    ],
    "client": [
      "com.gaffix.catnip.client.CatnipClient"
    ]
  },
  "mixins": [
    {
      "config": "catnip.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
